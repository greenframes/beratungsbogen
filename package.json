{
  "name": "beratungsbogen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interaktive iPad-Ausbildungsberatung der Aschke Seminare und Qualifizierung GmbH – Pflegeschule Hagen",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && node scripts/precache.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/run.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.48.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
